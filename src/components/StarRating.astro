---
import { clampRating, formatRatingValue, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    emptyLabel?: string;
    showScale?: boolean;
}

const { rating, emptyLabel, showScale = false } = Astro.props;
---

{(rating !== null || emptyLabel !== undefined) && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {rating !== null && <span class="text-yellow-400">{formatStarRating(rating)}</span>}
            {rating === null
                ? emptyLabel
                : showScale
                  ? formatRatingValue(rating)
                  : clampRating(rating).toFixed(1)}
        </span>
    </div>
)}
